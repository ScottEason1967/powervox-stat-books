{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/Statutory_Register.html" }
  ],
  "functions": {
    "api/companies-house.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/**"
    }
  },
  "headers": [
    {
      "source": "/api/companies-house",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
